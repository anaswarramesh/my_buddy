[Unit]
Description=CoachPilot AI Standalone Hardware Desk Companion
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/coach-pilot/hardware/raspberry_pi
ExecStartPre=/bin/sleep 5
ExecStart=/usr/bin/python3 /home/pi/coach-pilot/hardware/raspberry_pi/device_app.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
