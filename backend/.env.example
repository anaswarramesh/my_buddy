# App Configuration
APP_NAME=CoachPilot
APP_ENV=development
PORT=8000
HOST=0.0.0.0

# Database Configuration (Defaults to SQLite for local development, or Supabase PostgreSQL)
DATABASE_URL=sqlite:///./coach_pilot.db

# LLM Providers (OpenAI / Anthropic / Gemini)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=gemini # 'openai', 'gemini', 'anthropic', 'simulation'

# Calendar Sync
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CALDAV_USERNAME=
CALDAV_PASSWORD=
CALDAV_URL=
